{
    "name": "microscrap/gpio",
    "description": "Unix gpiod Bindings for The PHP Posi Extension",
    "type": "library",
    "version": "0.8.0",
    "keywords": [
        "framework",
        "scrapyard-io",
        "gpio",
        "gpiod",
        "posi",
        "bindings"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/gpio/0.7.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/gpio/0.7.x/overview",
        "source": "https://github.com/microscrap/gpio",
        "issues": "https://github.com/microscrap/gpio/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-posi": "^0.8.0",
        "microscrap/posix": "^0.8.0"
    },
    "suggest": {
        "scrapyard-io/gpio-framework": "GPIO application framework over Microscrap protocol bindings (^0.7)"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\GPIO\\": "src/"
        },
        "files": [
            "src/Helpers/gpio-chip.php",
            "src/Helpers/gpio-chip-info.php",
            "src/Helpers/gpio-info-event.php",
            "src/Helpers/gpio-edge-event.php",
            "src/Helpers/gpio-edge-event-buffer.php",
            "src/Helpers/gpio-line-info.php",
            "src/Helpers/gpio-line-request.php",
            "src/Helpers/gpio-line-config.php",
            "src/Helpers/gpio-line-settings.php",
            "src/Helpers/gpio-request-config.php",
            "src/Helpers/gpio-misc.php",
            "src/Helpers/gpio-internal.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
